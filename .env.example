# ===========================================
# DataSentry-AI Environment Configuration
# ===========================================

# ===========================================
# GENERAL
# ===========================================
NODE_ENV=development
PROJECT_NAME=DataSentry-AI

# ===========================================
# FRONTEND
# ===========================================
VITE_API_URL=http://localhost:3001/api
VITE_ML_SERVICE_URL=http://localhost:8000/api

# ===========================================
# BACKEND (NestJS)
# ===========================================
PORT=3001
BACKEND_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://datasentry_user:datasentry_password@localhost:5432/datasentry_db?schema=public

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ML Service
ML_SERVICE_URL=http://ml-service:8000

# ===========================================
# ML SERVICE (Python/FastAPI)
# ===========================================
PYTHON_ENV=development
ML_SERVICE_PORT=8000

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
POSTGRES_USER=datasentry_user
POSTGRES_PASSWORD=datasentry_password
POSTGRES_DB=datasentry_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===========================================
# AWS CONFIGURATION
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# S3 Buckets
S3_BUCKET_DATASETS=datasentry-datasets-dev
S3_BUCKET_MODELS=datasentry-models-dev
S3_BUCKET_REPORTS=datasentry-reports-dev

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===========================================
# FILE UPLOAD
# ===========================================
MAX_FILE_SIZE=104857600
# 100MB in bytes

# ===========================================
# CLOUDWATCH (Production)
# ===========================================
CLOUDWATCH_LOG_GROUP=/datasentry/application
CLOUDWATCH_LOG_STREAM=backend

# ===========================================
# SECRETS MANAGER (Production)
# ===========================================
USE_SECRETS_MANAGER=false
SECRETS_MANAGER_PREFIX=datasentry/

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_SWAGGER=true
ENABLE_DEBUG_MODE=true
ENABLE_PERFORMANCE_MONITORING=false
